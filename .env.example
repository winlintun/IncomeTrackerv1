# Flask Configuration
# REQUIRED in production: without it the app refuses to start
# (falls back to an insecure dev key only when FLASK_ENV=development).
SECRET_KEY=your-secret-key-here

# REQUIRED in production: PostgreSQL connection string.
# In development you may omit this to use local SQLite.
DATABASE_URL=postgresql://user:password@localhost:5432/yourdb

# Optional: enables development fallbacks (local SQLite, dev SECRET_KEY)
# FLASK_ENV=development
