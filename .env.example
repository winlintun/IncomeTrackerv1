# Flask Configuration
# REQUIRED in production: without it the app refuses to start
# (falls back to an insecure dev key only when FLASK_ENV or APP_ENV is development).
SECRET_KEY=your-secret-key-here

# REQUIRED in production: PostgreSQL connection string.
# In development you may omit this to use local SQLite.
# Local PostgreSQL (local non-Docker runs only; containers cannot reach the
# host via localhost - use the host gateway below instead):
# DATABASE_URL=postgresql://user:password@localhost:5432/yourdb
# PostgreSQL on the Docker host (from containers on the same Linux server):
# DATABASE_URL=postgresql://user:password@172.17.0.1:5432/yourdb
# Docker Desktop (macOS / Windows): use host.docker.internal instead of 172.17.0.1.
# Real passwords live only in .env (gitignored) - never in tracked files.

# Optional: enables development fallbacks (local SQLite, dev SECRET_KEY)
# FLASK_ENV=development

# Optional: Docker-only dev flag. FLASK_ENV is NOT passed into containers;
# set APP_ENV=development in .env to opt a container into dev mode.
# APP_ENV=development

# Optional: port for Gunicorn / Docker (default: 3000)
# PORT=3000

# Optional: bundled PostgreSQL settings (used by docker-compose.local-db.yml)
# POSTGRES_USER=incometracker
# POSTGRES_PASSWORD=incometracker
# POSTGRES_DB=incometracker
